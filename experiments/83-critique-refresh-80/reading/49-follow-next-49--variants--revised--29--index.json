      "text": "One destination.\nFour review units.",
      "y": 160
    },
    {
      "tag": "H2",
      "id": "boundary-title",
      "text": "The boundary at this PR’s head",
      "y": 615
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Take the four cuts. Keep their costs attached.",
      "y": 1171
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Own time\n↗",
      "y": 1397
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Own process authority\n↗",
      "y": 1397
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Stage a package\n↗",
      "y": 1965
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Give hosts a client\n↗",
      "y": 1965
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Who supplies a timestamp?",
      "y": 2987
    },
    {
      "tag": "H3",
      "id": "",
      "text": "The idle interval still belongs to acceptance",
      "y": 3382
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Who may act on this instance?",
      "y": 4005
    },
    {
      "tag": "H3",
      "id": "",
      "text": "One comparison owner, several claims",
      "y": 4300
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Where is the runnable implementation?",
      "y": 5116
    },
    {
      "tag": "H2",
      "id": "",
      "text": "What must a host know?",
      "y": 6391
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Stop at the first decision",
      "y": 6770
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Separate the questions; keep the dependencies.",
      "y": 7958
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Where the existing 45 commits land",
      "y": 8453
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Why stop at four?",
      "y": 8711
    },
