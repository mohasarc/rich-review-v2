    {
      "tag": "H2",
      "id": "",
      "text": "Nine received. Six read.",
      "y": 3741
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Move the source, keep the number.",
      "y": 4178
    },
    {
      "tag": "H2",
      "id": "",
      "text": "The triangle supplies the same required input.",
      "y": 4651
