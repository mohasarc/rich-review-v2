{
  "title": "PR 131 · The shape of a required choice",
  "headings": [
    {
      "tag": "H1",
      "id": "",
      "text": "The shape of\na required choice.",
      "y": 169
    },
    {
      "tag": "H2",
      "id": "",
      "text": "The decisions you can see from here",
      "y": 1059
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Make missing policy a type mismatch.",
      "y": 1175
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Retire parallel tuning surfaces.",
      "y": 1175
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Name a purpose. Carry two budgets.",
      "y": 1175
    },
    {
      "tag": "H3",
      "id": "",
      "text": "A section is still a structural shape.",
      "y": 1430
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Less configuration can mean more assignable values.",
      "y": 1430
    },
    {
      "tag": "H3",
      "id": "",
      "text": "One new capacity remains optional.",
      "y": 1430
    },
    {
