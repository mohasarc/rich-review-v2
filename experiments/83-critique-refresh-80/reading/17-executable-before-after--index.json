{
  "title": "PR 127 · Execute the boundary",
  "headings": [
    {
      "tag": "H1",
      "id": "",
      "text": "Same questions.\nA different lifetime owner.",
      "y": 141
    },
    {
      "tag": "H2",
      "id": "",
      "text": "What the human is deciding about",
      "y": 1029
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Core owns generic cache lifetime; TypeScript keeps query bodies.",
      "y": 1101
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Keep six isolated key/value spaces and the existing projections.",
      "y": 1101
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Use Map.has so an undefined factory value is still cached.",
      "y": 1203
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Clear only after refresh succeeds—even if source bytes did not change.",
      "y": 1203
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Clear synchronously; keep backend release joined to project release.",
      "y": 1304
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Preserve exact values: rejected promises stay; synchronous throws retry.",
      "y": 1304
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Narrow service beginTurn from a whole snapshot to a file list.",
      "y": 1424
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Expose getOrCreate handles; clearing keeps those handles reusable.",
      "y": 1424
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Add ten characterizations; retain existing test assertions.",
      "y": 1543
    },
    {
      "tag": "H2",
      "id": "",
      "text": "One input. Two real executions.",
      "y": 1908
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Reused search, fresh projection?",
      "y": 3002
    },
    {
      "tag": "H3",
      "id": "",
      "text": "The exported scope accepts more than promises",
      "y": 3262
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Where these observations come from",
      "y": 3781
    },
    {
      "tag": "H3",
