+  private signal(processId: number, signal: NodeJS.Signals): void {
+    try {
+      process.kill(processId, signal);
+    } catch (error) {
+      if (NodeTestProcessTerminator.errorCode(error) !== "ESRCH") throw error;
+    }
+  }
