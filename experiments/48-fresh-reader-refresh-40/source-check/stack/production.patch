+        heartbeatIntervalMs: 100,
+        authorizationPollIntervalMs: 10,
+        observationPollIntervalMs: 20,
+        previousInstanceTerminationTimeoutMs: 5 * 60_000,
+        childFailureRetryLimit: 1,
+      },
+      shutdown: {
