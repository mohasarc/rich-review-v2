+      [startup, "observationPollIntervalMs"],
+      [shutdown, "controllerPollIntervalMs"],
+      [shutdown, "processExitPollIntervalMs"],
+      [shutdown, "resourceDrainAcknowledgementPollIntervalMs"],
+      [resources, "supervisionIntervalMs"],
