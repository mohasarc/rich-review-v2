+const MEBIBYTE = 1024 * 1024;
+
+interface DaemonRuntimeProcess {
+  constrainedMemory?: () => number | undefined;
+  binding(name: "os"): { getTotalMem(): number };
+}
+
+export interface DaemonSystemMemory {
+  readonly totalBytes: number;
