+    const directory = mkdtempSync(join(tmpdir(), "symnav-worker-resource-sampling-"));
+    const worker = createInjectedWorker(
+      new URL("../../test/helpers/resource-sampling-daemon-executor-fixture.mjs", import.meta.url)
+        .href,
