+        responseCapacityExceeded: false,
+        workerExited: true,
+        shutdownFailureCode: "stopping",
+        shutdownStarted: true,
+      },
+      "stopping",
+    ],
+    [
+      "worker exit during controlled shutdown",
+      {
+        resourceInterrupted: false,
+        responseCapacityExceeded: false,
+        workerExited: true,
+        shutdownFailureCode: "controlled-resource",
+        shutdownStarted: true,
+      },
