+    expect(first.frames.map(DeliverySend.frameKind)).toEqual([
+      "accepted",
+      "result-manifest",
+      "chunk",
+      "result-end",
+    ]);
+    expect(duplicate.frames.map(DeliverySend.frameKind)).toEqual([
+      "accepted",
+      "result-manifest",
+      "chunk",
+      "result-end",
+    ]);
