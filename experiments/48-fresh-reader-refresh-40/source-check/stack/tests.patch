+        return encoded;
+      },
+      "Corrupt command output",
+    ],
+    [
+      "invalid stream",
+      (encoded: Buffer) => {
+        encoded.writeUInt8(2, 4);
+        return encoded;
+      },
+      "Corrupt command output",
+    ],
