+} from "./completion-spool.js";
+import { DaemonDeliverySession, type DaemonDiagnosticRecorder } from "./delivery-session.js";
+import { DaemonOperationObserver } from "../diagnostics/operation-observer.js";
+import type { DaemonDiagnosticEvent, DaemonServerMessage } from "../transport/protocol.js";
+import type { DaemonServerSend } from "../transport/contracts.js";
+
+describe("DaemonDeliverySession", () => {
+  const directories: string[] = [];
+
+  afterEach(async () => {
