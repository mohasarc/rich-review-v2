{
  "title": "One policy, many consumers · PR 131",
  "headings": [
    {
      "tag": "H1",
      "id": "title",
      "text": "One policy.\nMany places to feel it.",
      "y": 145
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Start with the widest reach.",
      "y": 928
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Outside the reach of refs",
      "y": 3668
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Keep startup coordination separate from healthy warm-up",
      "y": 1179
    },
    {
      "tag": "H2",
      "id": "",
      "text": "A reproducible count, with a visible blind spot.",
      "y": 4364
    },
    {
      "tag": "H3",
      "id": "",
      "text": "What is counted",
      "y": 4429
    },
    {
      "tag": "H3",
      "id": "",
      "text": "The policy-field query misses consumers.",
      "y": 4485
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Reproduce or change the seed choices",
      "y": 4784
    },
