      "text": "Observed result",
      "y": 0
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Cleanup is still pending. Can a repeated query obtain a fresh entry?",
      "y": 3565
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Fetch allowance is three. Must an incomplete fetched stream be tried three times?",
      "y": 3565
    },
    {
