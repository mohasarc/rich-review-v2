    {
      "tag": "H3",
      "id": "",
      "text": "Authority crosses; mechanisms stay.",
      "y": 1585
    },
    {
      "tag": "H3",
      "id": "",
      "text": "One chunk ceiling, several jobs.",
      "y": 1585
    },
    {
      "tag": "H3",
      "id": "",
      "text": "The number does not name the purpose.",
      "y": 1807
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Two allowances, two scopes.",
      "y": 1807
    },
    {
      "tag": "H3",
      "id": "",
      "text": "A numeric budget is not a fetch loop.",
      "y": 2008
    },
    {
      "tag": "H3",
      "id": "",
      "text": "A leaf now requires an earlier parse.",
      "y": 2008
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Startup grace is not a warmup deadline.",
      "y": 2246
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Shutdown contains several clocks.",
      "y": 2246
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Use the resource snapshot directly.",
      "y": 2447
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Retaining traces is not rotating logs.",
      "y": 2447
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Test adapters translate, rather than mirror.",
      "y": 2669
    },
    {
      "tag": "H3",
      "id": "",
      "text": "The evidence changes with the inputs.",
      "y": 2669
