    {
      "tag": "H3",
      "id": "",
      "text": "A lookup keeps the exact factory value.",
      "y": 1415
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Clearing forgets entries. It leaves held promises alone.",
      "y": 1583
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Stored identity is not every public return’s identity.",
      "y": 1729
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Only a successful refresh begins the next turn.",
      "y": 1876
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Cache clear and project cleanup have separate endings.",
      "y": 2022
    },
    {
      "tag": "H3",
      "id": "",
      "text": "Callers get lookup; the scope gets clear.",
      "y": 2209
    },
    {
      "tag": "H3",
      "id": "",
      "text": "The tests add contracts; they do not demonstrate full parity.",
      "y": 2335
    },
    {
      "tag": "H2",
      "id": "",
      "text": "Receipts, not an imitation of execution.",
      "y": 2596
