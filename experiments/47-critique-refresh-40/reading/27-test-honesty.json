    {
      "tag": "SUMMARY",
      "id": "",
      "text": "13\nName the process coordinator and validate before composing it\nWorkspaceDaemon becomes DaemonProcessCoordinator. Invalid coordinates fail before policy is observed; six cyclic ca",
      "href": null,
      "type": null,
      "visible": true
    },
