    {
      "tag": "SUMMARY",
      "id": "",
      "text": "10\nOwn warm capture, controlled outputs and replay decisions\nThe client allocates fresh temporary captures and returns exact failure text. Tests distinguish retry-safe fallback fro",
      "href": null,
      "type": null,
      "visible": true
    },
