    {
      "tag": "SUMMARY",
      "id": "",
      "text": "14\nSpecify which credentials each request checks first\nExecution-family requests check protocol/instance before token; ping/stop remain token-free. Identify and termination use ins",
      "href": null,
      "type": null,
      "visible": true
    },
