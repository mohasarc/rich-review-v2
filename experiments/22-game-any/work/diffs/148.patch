+  }
+
+  private static isCurrentRecord(record: DaemonRecord): boolean {
+    if (
+      record.schemaVersion !== DAEMON_RECORD_SCHEMA_VERSION ||
+      record.protocolVersion !== DAEMON_PROTOCOL_VERSION
