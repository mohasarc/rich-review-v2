+      throw error;
+    }
+  }
+
+  private recordPaths(): readonly string[] {
+    try {
+      return readdirSync(this.registryDirectory, { withFileTypes: true }).flatMap((entry) =>
+        entry.isDirectory() ? this.recordPathsIn(join(this.registryDirectory, entry.name)) : [],
