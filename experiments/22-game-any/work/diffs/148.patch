+  DaemonExecutionFailures,
+  type DaemonRejectedExecutionFrame,
+} from "@symnav/daemon";
+import type { CompletionSpoolManifest } from "../delivery/completion-spool.js";
+import type {
+  DaemonExecuteRequest,
+  DaemonExecutionServerFrame,
