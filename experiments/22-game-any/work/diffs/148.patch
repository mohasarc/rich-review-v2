+      response.instanceId !== request.instanceId ||
+      response.processToken !== request.processToken ||
+      response.requestId !== request.requestId ||
+      response.transferId !== transferId
+    ) {
+      throw new Error("Invalid daemon result acknowledgement");
+    }
+  }
