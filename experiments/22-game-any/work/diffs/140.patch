+import { DaemonAdmissionRejections, type DaemonExecuteRejectionCode } from "@symnav/daemon";
+
+export type DaemonDeliveryState = "not-submitted" | "submitted-unconfirmed" | "accepted";
+
+export type DaemonTransportFailureCode =
+  | "unreachable"
+  | "timeout"
+  | "corrupt"
