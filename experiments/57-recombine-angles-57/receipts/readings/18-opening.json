    "headings": [
      {
        "tag": "H1",
        "id": "",
        "text": "The caller still takes\nthe old road."
      },
      {
        "tag": "H2",
        "id": "",
        "text": "One new home. The active connection stays."
      },
      {
        "tag": "H2",
        "id": "",
        "text": "The new client is available.\nThe CLI still composes locally."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "“Frozen” describes the end of this PR."
      },
      {
        "tag": "H2",
        "id": "",
        "text": "The daemon still does not\nunderstand your symbols."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "Host keeps"
      },
      {
        "tag": "H3",
        "id": "",
        "text": "DaemonClient owns"
      },
      {
        "tag": "H2",
        "id": "",
        "text": "A new address for\nthe same machinery."
      },
      {
        "tag": "H2",
        "id": "",
        "text": "A fresh clock owner.\nThe same old idle interval."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "How much idle time is left after a turn?"
      },
      {
        "tag": "H2",
        "id": "",
        "text": "One place decides\nwhose process this is."
      },
      {
        "tag": "H2",
        "id": "",
        "text": "A decision stops\nthe rest of the route."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "Inspect the staged client's routing sequence"
      },
      {
        "tag": "H3",
        "id": "",
        "text": "Lifecycle calls stay recognizable"
      },
      {
        "tag": "H2",
        "id": "",
        "text": "An uncertain warm result\nstays a warm result."
      },
      {
        "tag": "H2",
        "id": "",
        "text": "Source can stay still\nwhile its evidence moves."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "37 mechanism test files move into the package."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "CLI entry tests are deleted; built package entry tests are added."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "The real CLI worker oracle becomes a generic executor oracle."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "The temporary policy-testing doorway and its lint checks disappear."
      },
      {
        "tag": "H3",
        "id": "",
        "text": "The end-to-end expectations stay."
