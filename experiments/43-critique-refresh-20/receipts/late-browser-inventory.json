    "headings": [
      {
        "level": "H1",
        "text": "Six caches share a reset.\nRelease gains a wait.",
        "id": "title"
      },
      {
        "level": "H2",
        "text": "Two boundaries to carry with you.",
        "id": "whole-title"
      },
