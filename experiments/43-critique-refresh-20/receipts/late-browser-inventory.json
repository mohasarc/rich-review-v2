      },
      {
        "level": "H3",
        "text": "Move reusable lifetime to core.",
        "id": "intent"
      },
      {
        "level": "H3",
        "text": "Show an awaited backend barrier.",
        "id": "intent"
      },
      {
        "level": "H3",
        "text": "Connect project failure to the caller.",
        "id": "intent"
      },
      {
        "level": "H2",
        "text": "The factory's return is the cache entry.",
