        "level": "H2",
        "text": "Twelve decisions. Reasons kept separate.",
        "id": "decisions"
      },
      {
        "level": "H3",
        "text": "Move the clearing job into core\n↘",
        "id": "D01"
      },
      {
        "level": "H3",
        "text": "Keep six independent stores\n↘",
        "id": "D02"
      },
      {
        "level": "H3",
        "text": "Compose a local scope; place it under core/backend\n↘",
        "id": "D03"
      },
      {
        "level": "H3",
        "text": "Preserve entries, distinguish their projections\n↘",
        "id": "D04"
      },
      {
        "level": "H3",
        "text": "Treat undefined as a present entry\n↘",
        "id": "D05"
      },
      {
        "level": "H3",
        "text": "Keep rejected promises; retry synchronous throws\n↘",
        "id": "D06"
      },
      {
        "level": "H3",
        "text": "Begin the next turn after refresh succeeds\n↘",
        "id": "D07"
      },
      {
        "level": "H3",
        "text": "Empty entries before starting project cleanup\n↘",
        "id": "D08"
      },
      {
        "level": "H3",
        "text": "Extend the backend's completion and error boundary\n↘",
        "id": "D09"
      },
      {
        "level": "H3",
        "text": "Pass files across the exported service API\n↘",
        "id": "D10"
      },
      {
        "level": "H3",
        "text": "Clear values while keeping handles usable\n↘",
        "id": "D11"
      },
      {
        "level": "H3",
        "text": "Add ten tests and retain all five existing cases\n↘",
        "id": "D12"
      },
      {
        "level": "H2",
        "text": "Five questions. Six stores. Shared work.",
