+      .spyOn(coordinatorPrototype, "workspaceDeletedAfterDelivery")
+      .mockResolvedValue(undefined);
+    const idleCallback = vi
+      .spyOn(coordinatorPrototype, "drainAndShutdown")
+      .mockResolvedValue(undefined);
