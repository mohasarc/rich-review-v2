+    if (observation.kind === "unresponsive") return { kind: "cold", reason: "recovering" };
+    if (observation.kind === "exited") {
+      try {
+        context.removeIfProcess(record);
+      } catch {}
+      return { kind: "fallback", reason: "dead" };
+    }
+    return { kind: "fallback", reason: "incompatible" };
+  }
+}
