    {
      "tag": "SUMMARY",
      "text": "E01PR: compatibility intent",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E02PR: composed scope and awaited barrier",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E03PR: reason for six handles",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E04PR: reason for presence checks",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E05PR: reason for clearing before release",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E06PR: reason for success-only turn change",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E07PR: public surfaces",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E08Plan: bases and language ownership",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E09Plan: preserve behavior and separate fixes",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E10Before: six Maps and snapshot input",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E11After: scope, handles, files input",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E12Core: entire new lifecycle implementation",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E13Before: refresh and detached release",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E14After: refresh, awaited release, and async query wrappers",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E15Before: clear, start graph release, return void",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E16After: clear, await graph release",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E17Existing graph: sequential release with awaits",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E18Existing concrete project: synchronous cleanup",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E19Handle: presence check, raw value, set after factory",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E20Scope: registry and repeatable clear",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E21Definitions: factory and observer remain on misses",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E22Call queries: original algorithms in factories",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E23Position cache: locations in, nodes rehydrated out",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E24Before: same location and node projection",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E25References: per-access projection outside cached locations",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E26Reference discovery can throw before Promise.resolve",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E27Before: same synchronous reference discovery",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E28New test: identity, undefined, isolated handles",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E29New test: turn clear, repeated release, reusable handles",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E30New test: rejected promise versus synchronous throw",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E31New test: old settlement cannot replace new entry",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E32New test: four direct query promise identities",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E33New test: empty locations and per-access node arrays",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E34New tests: async failure retention and sync retry",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E35New test: failed refresh retains current turn",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E36New test: pending and rejecting release double",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E37Retained tests: shared references and next-turn clearing",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E38Retained tests: repeated targets and diamond paths",
      "id": "",
      "href": null,
      "type": null
    },
    {
      "tag": "SUMMARY",
      "text": "E39Retained test: rebuilding released semantics",
      "id": "",
      "href": null,
      "type": null
