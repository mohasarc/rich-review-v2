+      "logRotateBytes",
+      "logBackupCount",
+      "maximumQueuedEvents",
+      "disconnectedTraceRetentionMs",
+      "maximumDisconnectedTraces",
+    ]);
+    for (const section of [
+      transport,
+      startup,
+      shutdown,
+      delivery,
+      output,
