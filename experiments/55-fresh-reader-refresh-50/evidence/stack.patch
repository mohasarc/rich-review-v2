+    } else {
+      setTimeout(() => void this.shutdown("graceful", true), 0);
+    }
+    return {
+      kind: request.kind === "terminate" ? "terminating" : "killing",
+      instanceId: this.options.coordinates.instanceId,
+      processToken: this.options.coordinates.processToken,
+    };
+  }
