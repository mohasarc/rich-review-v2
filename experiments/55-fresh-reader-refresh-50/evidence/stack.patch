+    expect(harness.readRecord).not.toHaveBeenCalled();
+    expect(harness.observe).not.toHaveBeenCalled();
+    await harness.context.readRecord();
+    await harness.context.readRecord();
+    await harness.context.observe(record());
+    await harness.context.observe(record());
