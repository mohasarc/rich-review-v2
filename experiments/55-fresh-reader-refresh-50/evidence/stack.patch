+
+    await expect(
+      state.refresh([workspaceFile("a.ts", "renamed-a", "/renamed/a.ts")]),
+    ).resolves.toEqual({ added: 0, changed: 0, removed: 1, unchanged: 1 });
+    expect(state.currentFileCount()).toBe(1);
+
+    await expect(
